# Oversized audiobook files: keep local, publish via external hosting/GitHub Releases/LFS.
Рамаяна 1986. Книга 5. Прекрасная.MP3
Рамаяна 1986. Книга 6. Битва.MP3

# Oversized Word source (109 MB, over GitHub's 100 MiB push limit): keep local,
# only the converted .md (Leitan-Sundarakanda/_Перевод сундараканды.md) is tracked.
Leitan-Sundarakanda/_Перевод сундараканды.docx

# Internal scraps and unrelated working files (RuWritingStyles etc.) — keep local only
_meta/

# Pre-render build output (generated by scripts/prerender.py in CI)
dist/

# Private donation ledger — never commit donor data
donations_private.csv
_private/

# audit sidecars
.contributing_old.md
.contributing_audit.txt

# Claude Code local settings/permissions — personal, not shared
.claude/

# secrets
.env

# Python bytecode cache
__pycache__/
*.pyc
.pytest_cache/

# Local working copies of the InDesign proof PDFs (H2632, 13-08-2026).
# Byte-identical duplicates of the tracked originals under
# Litpam-Indexator/InDesign/Ramayana_{I,II}_12.10.25/ — keeping a second copy
# under docs/ out of git stops them re-appearing as untracked dirt in every sweep.
Litpam-Indexator/docs/*.pdf

# Print-readiness working copies of InDesign packages (H2588 contract, IMPLEMENTATION step 4).
/Litpam-Indexator/work/print-readiness/
/Litpam-Indexator/artifacts/print-readiness/*/*/contact-sheets/
