// общие переменные скриптов AddSeeTopic.jsx и NameAndNick.jsx
//var folderName = "AddedLinesToIndex"; // название папки, в которой собираются строки терминов нижних уровней. Эта папка ддолжна быть в том же каталоге, где скрипт
var textPointer = "см."; // только слово. Пробелы добавляются по месту, там, где надо. Пробел -- это переменная sp | 10.07.2026 (H377): дефолт вернулся к "см." — при отсутствии sets/#AddSeeTopic.ini ссылки получались английским "see"
//var textPointer = "see"; // прежний англ. дефолт, отключён 10.07.2026 (H377)
var seeTopicArray = ["см.", "См.", "— см.", "— См.", "– см.", "– См."]; // массив используется в скрипте AlsoSeeTopic.jsx
var sp = " ";
var sepChar = "#";

