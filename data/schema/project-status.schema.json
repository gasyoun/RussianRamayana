{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Статус книг IV–VI",
  "type": "object",
  "required": ["books"],
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
