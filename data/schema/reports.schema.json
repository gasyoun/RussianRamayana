{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Отчёты о сборе средств",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["date", "title", "summary", "collected_rub", "donor_count"],
    "properties": {
      "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
      "title": {"type": "string"},
      "summary": {"type": "string"},
      "collected_rub": {"type": "integer", "minimum": 0},
      "donor_count": {"type": "integer", "minimum": 0},
      "spending": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["item", "amount_rub"],
          "properties": {
            "item": {"type": "string"},
            "amount_rub": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": true
        }
      },
      "note": {"type": "string"}
    },
    "additionalProperties": true
  }
}
